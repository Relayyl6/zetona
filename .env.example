# ==============================================================================
# Zetona_E Portfolio Environment Configuration
# ==============================================================================

# ----------------- Database (Neon Lakebase PostgreSQL) -----------------
DATABASE_URL="postgresql://neondb_owner:***@ep-***-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:***@ep-***.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
NEON_BRANCH_ID="br-aged-pine-be1cbiip"

# ----------------- Admin CMS Authentication -----------------
ADMIN_PASSWORD="your-strong-admin-password"

# ----------------- Media Storage (Cloudinary) -----------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ----------------- Email Notifications (Nodemailer Direct SMTP) -----------------
# Supports standard SMTP providers (Gmail, Outlook, Postmark, AWS SES, Zoho, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"Zetona_E Portfolio\" <your-email@gmail.com>"

# ----------------- Public Site URL -----------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
