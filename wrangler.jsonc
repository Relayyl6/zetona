{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zetona-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zetona-db",
      "database_id": "PLACEHOLDER_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_PUBLIC",
      "bucket_name": "zetona-public"
    },
    {
      "binding": "MEDIA_ORIGINALS",
      "bucket_name": "zetona-originals"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",    // Daily at 03:00 UTC (trash purge, orphan reaper)
      "0 4 * * 0"     // Weekly Sunday at 04:00 UTC (database backup export to R2)
    ]
  }
}
